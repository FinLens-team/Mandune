# 服务监听与候选版本（可选）。生产部署应把 APP_VERSION 设为候选 commit SHA。
HOST=127.0.0.1
PORT=8787
APP_VERSION=dev

# 单机 SQLite 私密状态。目录必须预先存在且仅服务用户可访问。
MANDONG_DB_PATH=/var/lib/mandong/mandong.sqlite3
# 可选：默认使用当前工作目录下的 migrations/。
# MANDONG_MIGRATIONS_DIR=/opt/mandong/migrations
# 可选：SQLite 写锁等待上限，默认 1000ms。
# MANDONG_DB_BUSY_TIMEOUT_MS=1000
# 动态日报运行时目录；必须位于持久可写状态目录，不要写 release/source tree。
# MANDONG_DAILY_BRIEFINGS_DIR=/var/lib/mandong/daily-briefings

# 供应商探测（#24 / tools/provider-probe）可选占位。不要提交真实凭据。
# PandaAI data-service username: country code 86 followed by the phone number.
# 生产主进程优先使用 PANDA_DATA_*；worker 子进程内再映射为 SDK 所需名称。
PANDA_DATA_USERNAME=86xxxxxxxxxxx
PANDA_DATA_PASSWORD=
# tools/provider-probe 仍读取 SDK 兼容名称；仅运行该探测工具时按需配置。
# PANDA_USERNAME=86xxxxxxxxxxx
# PANDA_PASSWORD=
# 可选：生产服务可执行的 Python 3.12 路径，默认 python3.12。
# PANDA_PYTHON_EXECUTABLE=/opt/mandong/panda/bin/python

# Bocha Web Search API key.
BOCHA_API_KEY=

# 服务端专用模型网关（OpenAI-compatible）。仅服务边界读取，
# 不要提交真实密钥，也不得进入 VITE_*、浏览器包、日志或 /health。
# 三项配置齐全即可跑真实分析；生产缺省会拒绝启动，避免用户路径出现 fixture。
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ID=
# 分析执行模式：stream（默认）= 真实行情 + 模型流式报告，仅需 MODEL_*；
# v2 = 严格每日复盘管线，另需 PandaAI Python worker 与 Bocha 凭据。
# MANDONG_ANALYSIS_MODE=stream
# AKShare 运行于隔离 Python 环境，查询基金、ETF 与 A 股日线并作为模型证据源。
# AKSHARE_PYTHON_EXECUTABLE=/opt/mandune/akshare/bin/python
# 可选：供应商名称，默认 model-gateway。
# MODEL_PROVIDER_NAME=model-gateway
# 可选：仅在对该 provider/model 做过结构化输出能力测试后才设为 true（默认 false）。
# MODEL_SUPPORTS_STRUCTURED_OUTPUTS=true
# 可选：Anthropic Messages 协议端点使用 anthropic_messages；默认 openai。
# MODEL_PROTOCOL=openai
# 可选：主模型失败时按序尝试备用模型。每组同样支持 PROVIDER_NAME、
# SUPPORTS_STRUCTURED_OUTPUTS 和 PROTOCOL。
# MODEL_FALLBACK_1_BASE_URL=
# MODEL_FALLBACK_1_API_KEY=
# MODEL_FALLBACK_1_ID=
# 可选：整次分析硬截止，范围 10000..3600000，默认 180000。
# MANDONG_ANALYSIS_DEADLINE_MS=180000

# 独立 A2A 1.0 深度复盘 Agent。比赛固定使用火山方舟 DeepSeek-Pro 接入点
# ep-20260708162855-pcf9x；接入点由服务端代码固定，不把它误当作 API Token。
# 只选择一个赛事 Token 配置为 ARK_API_KEY，且不得提交、记录或放入 VITE_*。
# ARK_API_KEY=
# 可选：默认 https://ark.cn-beijing.volces.com/api/v3；仅用于受控网关/本机测试覆盖。
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# A2A_BEARER_TOKEN=
# 可选：公开部署的 HTTPS origin；本机自测可留空，由请求 Host 推导。
# A2A_PUBLIC_BASE_URL=https://demo.example.com
