# 服务监听与候选版本（可选）。生产部署应把 APP_VERSION 设为候选 commit SHA。
HOST=127.0.0.1
PORT=8787
APP_VERSION=dev

# 单机 SQLite 私密状态。目录必须预先存在且仅服务用户可访问。
MANDONG_DB_PATH=/var/lib/mandong/mandong.sqlite3
# 可选：默认使用当前工作目录下的 migrations/。
# MANDONG_MIGRATIONS_DIR=/opt/mandong/migrations
# 可选：SQLite 写锁等待上限，默认 1000ms。
# MANDONG_DB_BUSY_TIMEOUT_MS=1000

# 供应商探测（#24 / tools/provider-probe）可选占位。不要提交真实凭据。
# PandaAI data-service username: country code 86 followed by the phone number.
PANDA_USERNAME=86xxxxxxxxxxx
PANDA_PASSWORD=

# Bocha Web Search API key.
BOCHA_API_KEY=

# 服务端专用模型网关（OpenAI-compatible，ADR-0006/0007）。仅服务边界读取，
# 不要提交真实密钥，也不得进入 VITE_*、浏览器包、日志或 /health。
# 配置齐全时运行时启用 PandaAI/Bocha 证据与单次结构化复盘；缺省则回退确定性 fixture。
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ID=step-explore
# 可选：供应商名称，默认 model-gateway。
# MODEL_PROVIDER_NAME=model-gateway
# 可选：仅在对该 provider/model 做过结构化输出能力测试后才设为 true（默认 false）。
# MODEL_SUPPORTS_STRUCTURED_OUTPUTS=true

# 独立 A2A 1.0 深度复盘 Agent。比赛固定使用火山方舟 DeepSeek-Pro 接入点
# ep-20260708162855-pcf9x；接入点由服务端代码固定，不把它误当作 API Token。
# 只选择一个赛事 Token 配置为 ARK_API_KEY，且不得提交、记录或放入 VITE_*。
# ARK_API_KEY=
# 可选：默认 https://ark.cn-beijing.volces.com/api/v3；仅用于受控网关/本机测试覆盖。
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# A2A_BEARER_TOKEN=
# 可选：公开部署的 HTTPS origin；本机自测可留空，由请求 Host 推导。
# A2A_PUBLIC_BASE_URL=https://demo.example.com
