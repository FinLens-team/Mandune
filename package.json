{
  "name": "mandune",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mandune（满懂）：带证据边界的每日持仓复盘",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22 <23",
    "pnpm": "10.33.2"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "check": "eslint . && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:smoke": "vitest run src/server/health.test.ts",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-runtime-assets.mjs",
    "build": "vite build && tsc -p tsconfig.server.json && node scripts/copy-runtime-assets.mjs",
    "start": "node dist/server/index.js",
    "maintenance:purge": "node --preserve-symlinks-main dist/persistence/maintenance.js purge-expired"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@hono/node-server": "^1.19.1",
    "ai": "^7.0.37",
    "hono": "^4.9.7",
    "lucide-react": "^1.26.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
