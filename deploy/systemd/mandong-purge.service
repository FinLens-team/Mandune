[Unit]
Description=Purge expired Mandong private workspaces
After=local-fs.target
ConditionPathExists=/opt/mandong/current/dist/persistence/maintenance.js

[Service]
Type=oneshot
User=mandong
Group=mandong
WorkingDirectory=/opt/mandong/current
EnvironmentFile=-/etc/mandong/mandong.env
EnvironmentFile=/etc/mandong/release.env
Environment=NODE_ENV=production
Environment=PATH=/opt/mandong/runtime:/usr/bin:/bin
Environment=MANDONG_DB_PATH=/var/lib/mandong/mandong.sqlite3
Environment=MANDONG_DB_BUSY_TIMEOUT_MS=1000
ExecStart=/usr/bin/env node --preserve-symlinks-main /opt/mandong/current/dist/persistence/maintenance.js purge-expired
UMask=0077
StateDirectory=mandong
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadWritePaths=/var/lib/mandong
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mandong-purge
