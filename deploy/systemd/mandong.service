[Unit]
Description=Mandong Demo V1
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300s
StartLimitBurst=3

[Service]
Type=simple
User=mandong
Group=mandong
WorkingDirectory=/opt/mandong/current
EnvironmentFile=-/etc/mandong/mandong.env
EnvironmentFile=/etc/mandong/release.env
Environment=NODE_ENV=production
Environment=PATH=/opt/mandong/runtime:/usr/bin:/bin
Environment=HOST=127.0.0.1
Environment=PORT=8791
Environment=MANDONG_DB_PATH=/var/lib/mandong/mandong.sqlite3
Environment=MANDONG_DB_BUSY_TIMEOUT_MS=1000
ExecStart=/usr/bin/env node --preserve-symlinks-main /opt/mandong/current/dist/server/index.js
Restart=on-failure
RestartSec=3s
TimeoutStartSec=240s
TimeoutStopSec=220s
KillSignal=SIGTERM
UMask=0077
StateDirectory=mandong
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/var/lib/mandong
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mandong
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
