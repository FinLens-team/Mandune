{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/features/**/*.ts",
    "src/features/**/*.tsx",
    "src/portfolio/**/*.ts",
    "src/extraction/**/*.ts",
    "src/contracts/**/*.ts",
    "vite.config.ts"
  ]
}
