{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false
  },
  "include": [
    "src/server/**/*.ts",
    "src/contracts/**/*.ts",
    "src/workspace/**/*.ts",
    "src/portfolio/**/*.ts",
    "src/extraction/**/*.ts"
  ]
}
