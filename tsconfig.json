{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@contracts/*": ["src/contracts/*"]
    }
  },
  "include": [
    "src/contracts/**/*.ts",
    "src/evidence/**/*.ts",
    "src/fixtures/**/*.ts",
    "src/providers/**/*.ts",
    "src/portfolio/**/*.ts",
    "src/workspace/**/*.ts",
    "src/extraction/**/*.ts",
    "src/analysis/**/*.ts",
    "src/model/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "vite.config.ts"
  ]
}
